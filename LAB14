using System;

class Account
{
    public int accountNo;
    public double balance;

    public Account(int acc, double bal)
    {
        accountNo = acc;
        balance = bal;
    }

    public virtual void deposit(double amount)
    {
        balance += amount;
        Console.WriteLine("Deposited: " + amount);
    }

    public virtual void withdraw(double amount)
    {
        if (amount <= balance)
        {
            balance -= amount;
            Console.WriteLine("Withdrawn: " + amount);
        }
        else
        {
            Console.WriteLine("Insufficient Balance");
        }
    }

    public void show()
    {
        Console.WriteLine("Account No: " + accountNo);
        Console.WriteLine("Balance: " + balance);
    }
}

class Savings : Account
{
    public double interestRate;

    public Savings(int acc, double bal, double rate) : base(acc, bal)
    {
        interestRate = rate;
    }

    public override void deposit(double amount)
    {
        balance += amount + (amount * interestRate / 100);
        Console.WriteLine("Deposited with Interest");
    }
}

class Current : Account
{
    public double overdraftLimit;

    public Current(int acc, double bal, double limit) : base(acc, bal)
    {
        overdraftLimit = limit;
    }

    public override void withdraw(double amount)
    {
        if (amount <= balance + overdraftLimit)
        {
            balance -= amount;
            Console.WriteLine("Withdrawn with Overdraft");
        }
        else
        {
            Console.WriteLine("Limit Exceeded");
        }
    }
}

class Program
{
    static void Main()
    {
        Savings s = new Savings(101, 5000, 5);
        s.deposit(1000);
        s.show();

        Console.WriteLine();

        Current c = new Current(102, 3000, 2000);
        c.withdraw(4000);
        c.show();
    }
}
